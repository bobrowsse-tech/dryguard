{
  "name": "@dryguard/cli",
  "version": "0.1.0",
  "description": "Headless DryGuard: `dryguard scan` for CI duplication reports and gating, `dryguard baseline` for adopting DryGuard on an existing codebase, and a pre-commit hook.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dryguard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dryguard/core": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
