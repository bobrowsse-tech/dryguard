{
  "name": "@dryguard/cli",
  "version": "0.1.1",
  "description": "Headless DryGuard: `dryguard scan` for CI duplication reports and gating, `dryguard baseline` for adopting DryGuard on an existing codebase, and a pre-commit hook.",
  "license": "MIT",
  "author": "Bob Rowsse Walakira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobrowsse-tech/dryguard.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/dryguard/issues"
  },
  "homepage": "https://github.com/bobrowsse-tech/dryguard/tree/main/packages/cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.12"
  },
  "type": "module",
  "bin": {
    "dryguard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@dryguard/core": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
