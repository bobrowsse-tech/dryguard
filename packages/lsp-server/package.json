{
  "name": "@dryguard/lsp-server",
  "version": "0.1.2",
  "description": "DryGuard Language Server — one implementation of DRY-violation diagnostics and quick fixes for every LSP-capable editor (VS Code, Neovim, JetBrains via LSP4IJ, Sublime, Helix, Emacs, ...).",
  "license": "MIT",
  "author": "Bob Rowsse Walakira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobrowsse-tech/dryguard.git",
    "directory": "packages/lsp-server"
  },
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/dryguard/issues"
  },
  "homepage": "https://github.com/bobrowsse-tech/dryguard/tree/main/packages/lsp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.12"
  },
  "type": "module",
  "bin": {
    "dryguard-lsp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@dryguard/core": "workspace:*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
