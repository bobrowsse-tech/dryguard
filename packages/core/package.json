{
  "name": "@dryguard/core",
  "version": "0.1.0",
  "description": "Structural duplicate-code detection engine for DryGuard (AST fingerprinting + similarity scoring).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "grammars"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ts-morph": "^24.0.0",
    "fast-glob": "^3.3.2",
    "web-tree-sitter": "^0.24.4"
  },
  "devDependencies": {
    "tree-sitter-wasms": "^0.1.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
