{
  "name": "@dryguard/core",
  "version": "0.1.0",
  "description": "Structural duplicate-code detection engine for DryGuard (AST fingerprinting + similarity scoring).",
  "license": "MIT",
  "author": "Bob Rowsse Walakira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobrowsse-tech/dryguard.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/dryguard/issues"
  },
  "homepage": "https://github.com/bobrowsse-tech/dryguard/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.12"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "grammars"],
  "scripts": {
    "build": "tsc -b && node ../../scripts/fetch-grammars.mjs",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "ts-morph": "^24.0.0",
    "fast-glob": "^3.3.2",
    "web-tree-sitter": "^0.24.4"
  },
  "devDependencies": {
    "tree-sitter-wasms": "^0.1.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
