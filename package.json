{
  "name": "dryguard",
  "private": true,
  "version": "0.0.0",
  "description": "DryGuard — structural duplicate-code detection for humans and AI coding agents, across every IDE.",
  "license": "MIT",
  "author": "Bob Rowsse Walakira",
  "repository": {
    "type": "git",
    "url": "https://github.com/dryguard-dev/dryguard.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --filter=./packages/* run dev",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "clean": "pnpm -r --filter=./packages/* run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
