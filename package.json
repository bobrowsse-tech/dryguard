{
  "name": "dryguard",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "DryGuard — structural duplicate-code detection for humans and AI coding agents, across every IDE.",
  "license": "MIT",
  "author": "Bob Rowsse Walakira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobrowsse-tech/dryguard.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.12"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --filter=./packages/* run dev",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "pretest": "node scripts/fetch-grammars.mjs",
    "test": "vitest run --coverage",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "clean": "pnpm -r --filter=./packages/* run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && node scripts/publish-if-configured.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign",
      "keytar"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
